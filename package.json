{
  "name": "xroad-asic-verifier",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm --filter @xrav/verifier test",
    "typecheck": "pnpm -r typecheck",
