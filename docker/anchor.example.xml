<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Example configuration anchor. It points at a placeholder host (cs.example.org)
  and carries a placeholder verification certificate, so the app starts but no
  global configuration will load. Replace it with your X-Road instance's internal
  configuration anchor (on a security server: /etc/xroad/configuration-anchor.xml).
-->
<ns3:configurationAnchor xmlns:ns2="http://x-road.eu/xsd/identifiers" xmlns:ns3="http://x-road.eu/xsd/xroad.xsd">
    <generatedAt>2026-01-01T00:00:00.000Z</generatedAt>
    <instanceIdentifier>EXAMPLE</instanceIdentifier>
    <source>
        <downloadURL>http://cs.example.org/internalconf</downloadURL>
        <verificationCert></verificationCert>
    </source>
    <source>
        <downloadURL>https://cs.example.org/internalconf</downloadURL>
        <verificationCert></verificationCert>
    </source>
</ns3:configurationAnchor>
