# Rendered by verifier-entrypoint. Shared by the /globalconf/ proxy locations.
# Upstream TLS is not verified (self-signed central server); trust comes from
# the directory signature checked in the browser against the anchor.
proxy_http_version 1.1;
proxy_ssl_server_name on;
proxy_ssl_name ${UPSTREAM_HOST};
proxy_ssl_verify off;
proxy_set_header Host ${UPSTREAM_HOSTPORT};
proxy_set_header Connection "";
proxy_set_header Cookie "";
proxy_set_header Authorization "";
proxy_hide_header Set-Cookie;
proxy_hide_header Cache-Control;
proxy_hide_header Expires;
proxy_redirect off;
proxy_connect_timeout 5s;
proxy_send_timeout 10s;
proxy_read_timeout 20s;
proxy_buffering on;
proxy_max_temp_file_size 0;
include /etc/nginx/verifier/security-headers.conf;
add_header Cache-Control "no-store" always;
